    #[arg(long, default_value_t = 1.0)]
    drop_pressure_lr_mult: f32,

    /// EGT head の learning rate boost 倍率。
    #[arg(long, default_value_t = 5.0)]
    endgame_tempo_lr_mult: f32,

    /// 2026-06-09 追加: Attack Relay Head (ARH) を有効化する。
